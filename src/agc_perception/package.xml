<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agc_perception</name>
  <version>0.0.0</version>
  <description>AGC 感知与融合（W4）：odom / gt / perception / fusion / map 适配</description>
  <maintainer email="agc@example.com">AGC Dev</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>agc_msgs</depend>
  <depend>yaml-cpp</depend>
  <!-- gz 真值旁路（gt_bypass）：经 gz-transport 直读 dynamic_pose/info；声明键取 vendor 包
       （对照 ros_gz_sim：gz-transport13 → gz_transport_vendor，gz-msgs10 → gz_msgs_vendor） -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
