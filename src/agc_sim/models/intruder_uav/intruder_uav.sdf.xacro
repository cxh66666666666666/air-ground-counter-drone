<?xml version="1.0"?>
<!--
  intruder_uav —— 可控目标（W2-interception）

  实现说明（全新重写）：
    * link 级 <gravity>false</gravity>：**失重**（SDF 的 gravity 属 link 而非 model）。
    * **可控化**（R9）：挂 GZ `VelocityControl`，外部经话题 `/model/intruder_uav/cmd_vel`
      发 Twist 速度指令即可脚本化驱动（半运动学，位置 = 速度积分）。**driver / 干扰注入
      节点属 W6**（[ADR-0016](../../../docs/adr/0016-execution-scope-exit-w6.md)）；
      本模型只提供"被控制的能力"。
    * 位姿亦可用 set_pose 服务直接置位（复位属 M0）。
    * 参数经 xacro 注入（默认值来自 agc_sim/config/target.yaml）。
    * 碰撞盒口径沿用旧树（0.32×0.32×0.10、mass 1.0）作为行为事实；visual 用基本几何+
      红色（辨识色），网格细化属 W2-full，不复制旧资产。
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="body_length" default="0.32"/>
  <xacro:arg name="body_width" default="0.32"/>
  <xacro:arg name="body_height" default="0.10"/>
  <xacro:arg name="body_mass" default="1.0"/>

  <model name="intruder_uav">
    <static>false</static>

    <link name="target/base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>$(arg body_mass)</mass>
        <inertia>
          <ixx>0.010</ixx>
          <iyy>0.010</iyy>
          <izz>0.020</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box><size>$(arg body_length) $(arg body_width) $(arg body_height)</size></box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box><size>$(arg body_length) $(arg body_width) $(arg body_height)</size></box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 可控化（R9）：外部速度指令驱动；driver / 干扰注入节点属 W6（ADR-0016） -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/intruder_uav/cmd_vel</topic>
    </plugin>

    <!-- 真值位姿旁路（W3）：发布 /model/intruder_uav/pose，供空中域 target_sim_source 取目标真值。
         正式 gt 通路（gt_adapter）属 W4；本插件是 W3 目标源的占位数据源。
         注意：PosePublisher 发布的是**相对父实体**的位姿 —— `publish_link_pose` 给的是
         「link 相对 model」的零位姿（frame_id=intruder_uav，无意义）；要拿**世界系**位姿
         必须开 `publish_model_pose`（model 的父即 world）。见 gz-sim 8 PosePublisher 文档/源码。 -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <!-- 频率必须限幅：默认「按步进（250 Hz）」会把 gz→桥→ROS 三段全灌满，
           实测拖垮同机的 PX4 EKF（`invalid setpoints` → `blind land`）。取 30 Hz 与
           车体 odom（DiffDrive odom_publish_frequency=30）同量级。 -->
      <update_frequency>30</update_frequency>
    </plugin>

  </model>
</sdf>