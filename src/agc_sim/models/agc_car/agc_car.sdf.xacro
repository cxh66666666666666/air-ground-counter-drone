<?xml version="1.0"?>
<!--
  agc_car —— 地面车模型（真实物理，ADR-0010；W2）

  基座来源：以 ROS 官方 `nav2_minimal_tb3_sim` 的 `urdf/gz_waffle.sdf.xacro`
  （TurtleBot3 waffle，Apache-2.0）为**结构基座**——沿用其差速两驱动轮 + 2 后万向球
  的布局、轮/关节位姿、接触与摩擦参数、DiffDrive 限幅；**不再从零手搓几何**。

  相对基座的改动：
    * 命名改为契约要求：模型 `agc_car`，机体系 `car/base_link`（禁止裸 base_link）；
    * 车体质量取旧树行为事实 2.0（TB3 原为 1.0）；碰撞盒沿用车体尺寸（0.265×0.265×0.089）；
    * 传感器：改用 3D 激光（Velodyne 语义，`gpu_lidar`）→ PointCloud2，挂 `car/lidar_link`
      （TB3 原为 2D `LaserScan` + depth 相机，此处不采用）；
    * visual 暂用基本几何（TB3 的 dae 网格为 `package://`，gz 不解析；网格细化延后）。
    * 不设 DiffDrive 的 topic/frame 覆盖，沿用默认 `/model/agc_car/{cmd_vel,odometry}`
      与 `_publisher` 默认帧（与 agc_sim 桥一致）。
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="wheel_separation" default="0.287"/>
  <xacro:arg name="wheel_radius" default="0.033"/>
  <xacro:arg name="wheel_width" default="0.018"/>
  <xacro:arg name="max_wheel_torque" default="20.0"/>
  <xacro:arg name="max_wheel_acceleration" default="1.0"/>
  <xacro:arg name="body_length" default="0.265"/>
  <xacro:arg name="body_width" default="0.265"/>
  <xacro:arg name="body_height" default="0.089"/>
  <xacro:arg name="body_mass" default="2.0"/>
  <!-- 拦截载荷（W2-interception，R10）：轻量附件、无碰撞；参数落 config -->
  <xacro:arg name="capture_net_radius" default="1.0"/>
  <xacro:arg name="payload_mass" default="0.05"/>

  <model name="agc_car">
    <static>false</static>

    <!-- 车体（基座：TB3 车身 link；原点约在轮轴高度） -->
    <link name="car/base_link">
      <inertial>
        <pose>0 0 0.048 0 0 0</pose>
        <inertia>
          <ixx>0.001</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.001</iyy><iyz>0.0</iyz><izz>0.001</izz>
        </inertia>
        <mass>$(arg body_mass)</mass>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry>
          <box><size>$(arg body_length) $(arg body_width) $(arg body_height)</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry>
          <box><size>$(arg body_length) $(arg body_width) $(arg body_height)</size></box>
        </geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
    </link>

    <!-- 左驱动轮（基座：wheel_left_link；位姿由 joint pose 给定，link 不重复给 pose） -->
    <link name="car/left_wheel">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        <mass>0.1</mass>
      </inertial>
      <collision name="wheel_left_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>$(arg wheel_radius)</radius><length>$(arg wheel_width)</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2><slip1>0.035</slip1><slip2>0</slip2><fdir1>0 0 1</fdir1></ode></friction>
          <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>$(arg wheel_radius)</radius><length>$(arg wheel_width)</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- 右驱动轮 -->
    <link name="car/right_wheel">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        <mass>0.1</mass>
      </inertial>
      <collision name="wheel_right_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>$(arg wheel_radius)</radius><length>$(arg wheel_width)</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1</mu><mu2>1</mu2><slip1>0.035</slip1><slip2>0</slip2><fdir1>0 0 1</fdir1></ode></friction>
          <contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>$(arg wheel_radius)</radius><length>$(arg wheel_width)</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- 后万向球（被动支撑；基座：caster_back_*） -->
    <link name="car/caster_back_left">
      <pose>0.177 0.064 -0.004 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
      </collision>
    </link>
    <link name="car/caster_back_right">
      <pose>0.177 -0.064 -0.004 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><contact><ode><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><kp>1e+5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
      </collision>
    </link>

    <!-- 3D 激光（W2-full 传感器链路；供 W4 costmap / W5 collision_monitor） -->
    <link name="car/lidar_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
      </inertial>
      <sensor name="lidar3d" type="gpu_lidar">
        <topic>/agc/car_lidar</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
            <vertical><samples>16</samples><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical>
          </scan>
          <range><min>0.2</min><max>20.0</max></range>
        </lidar>
      </sensor>
    </link>

    <!-- 拦截载荷（W2-interception，R10）：轻量附件、**无碰撞**、不改动 DiffDrive 标定 -->
    <!-- 捕获网面：直径 2 m 的圆面，法线朝前（+x），供 W6 物理捕获"穿越判据"使用 -->
    <link name="car/capture_net">
      <pose>0.45 0 0.10 0 0 0</pose>
      <inertial>
        <mass>$(arg payload_mass)</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="capture_net_visual">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>$(arg capture_net_radius)</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.5 0.9 0.5</ambient><diffuse>0.1 0.5 0.9 0.5</diffuse></material>
      </visual>
    </link>

    <!-- 干扰载荷：行为级电子干扰发射器（EMI 不建模）；行为接口属 W6 -->
    <link name="car/jammer">
      <pose>-0.10 0 0.16 0 0 0</pose>
      <inertial>
        <mass>$(arg payload_mass)</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="jammer_visual">
        <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.8 0.6 0.0 1</ambient><diffuse>0.9 0.7 0.0 1</diffuse></material>
      </visual>
    </link>

    <!-- 关节（基座布局；轮用 revolute，顺时针/逆时针由 DiffDrive 驱动） -->
    <joint name="left_wheel_joint" type="revolute">
      <pose>0 0.144 0.023 0 0 0</pose>
      <parent>car/base_link</parent>
      <child>car/left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <pose>0 -0.144 0.023 0 0 0</pose>
      <parent>car/base_link</parent>
      <child>car/right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="caster_back_left_joint" type="ball">
      <parent>car/base_link</parent>
      <child>car/caster_back_left</child>
    </joint>
    <joint name="caster_back_right_joint" type="ball">
      <parent>car/base_link</parent>
      <child>car/caster_back_right</child>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>car/base_link</parent>
      <child>car/lidar_link</child>
    </joint>
    <joint name="capture_net_joint" type="fixed">
      <parent>car/base_link</parent>
      <child>car/capture_net</child>
    </joint>
    <joint name="jammer_joint" type="fixed">
      <parent>car/base_link</parent>
      <child>car/jammer</child>
    </joint>

    <!-- 差速驱动（真实物理；限幅沿用 TB3 基座量级） -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>$(arg wheel_separation)</wheel_separation>
      <wheel_radius>$(arg wheel_radius)</wheel_radius>
      <max_wheel_torque>$(arg max_wheel_torque)</max_wheel_torque>
      <max_wheel_acceleration>$(arg max_wheel_acceleration)</max_wheel_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

  </model>
</sdf>