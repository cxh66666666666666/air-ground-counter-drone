<?xml version="1.0" ?>
<!--
  agc_world —— AGC 空地协同的唯一世界（GZ Sim / Harmonic，W2-min）

  **base world**（评审 S-06；ADR-0062）：本文件**不含**静态障碍 `pole_*` 块，是
  障碍生成所依据的 base。静态障碍几何的唯一真源为 `config/world_geometry.yaml`，
  由 `world_bringup.launch.py` 按 `world_obstacles`（`static`/`none`）**注入 / 不注入**
  障碍模型生成运行期世界（`none` 直接用本 base；`static` 生成 base + pole 临时世界）。

  设计要点（对齐旧树行为事实，WHAT；实现为 GZ Sim 全新重写，HOW 不继承）：
    * 单一世界：障碍在运行期由场景复位 spawn / toggle，不维护"静态/动态"两份 world。
    * 基准坐标系 ENU（+x 东、+y 北、+z 上），单位 m / m/s / rad。
    * 地面与光源**内联**定义（不依赖 model://sun / ground_plane 资源），保证自包含。
    * 物理引擎为 dart（GZ Sim 8/Harmonic 不再支持 ODE）；步长与更新率对齐旧树
      （max_step_size=0.004、real_time_update_rate=250），改则须重新标定 /clock。
    * 地面车 agc_car 与目标 intruder_uav **不在本 world 内**：由 world_bringup.launch.py
      经 ros_gz_sim create 按 config/*.yaml 参数 spawn（参数单一来源）。
    * 静态障碍 pole_1 / pole_2 的形态（0.3×0.3×3）沿用旧树；pose 于 **W3 打补丁**重排入 80×80 作业区（ADR-0019）。
      几何值现**只**存于 `config/world_geometry.yaml`（真源上移，S-06）。
    * **W3 打补丁**：补 PX4 必需系统插件 + `spherical_coordinates`；作业区放大到 80×80（车/目标 spawn 分离 ~30 m）。
-->
<sdf version="1.8">
  <world name="agc_world">

    <!-- 光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面（内联平面） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 物理：对齐旧树步长/更新率 -->
    <physics name="default_physics" default="1" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- 系统插件：**显式全量声明且按顺序**（W3 打补丁：补 PX4 必需插件）。
         顺序与 PX4 官方 Tools/simulation/gz/worlds/default.sdf 一致：
         Physics → UserCommands → SceneBroadcaster → Contact → Imu → AirPressure
         → ApplyLinkWrench → NavSat → Sensors。
         原因：默认 server.config 只含前三个；若仅额外声明 Sensors 而其余靠默认，
         插件加载顺序会错位（Sensors 先于 Physics/SceneBroadcaster），导致 server 在加载阶段挂死。
         Contact / Imu / AirPressure / ApplyLinkWrench / NavSat 为 PX4 SITL 挂入本 world 所需（W3-a，ADR-0019）。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 静态障碍 pole_1 / pole_2 **不**在本 base world 内：几何真源见 config/world_geometry.yaml，
         由 world_bringup.launch.py 生成运行期世界时按 world_obstacles 注入（S-06；ADR-0062）。 -->

    <!-- WGS84 / ENU 基准（W3 打补丁）：PX4 NavSat 等所需，与 agc_world 的 ENU 基准一致。 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>