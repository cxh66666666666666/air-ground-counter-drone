<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agc_sim</name>
  <version>0.0.0</version>
  <description>AGC 仿真世界与模型（W2）：单一世界、车/目标模型、ros_gz 桥</description>
  <maintainer email="agc@example.com">AGC Dev</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- GZ 侧末端失效停车守门人（R-009，ADR-0025）：gz-sim System 插件，直连 gz-transport；
       声明键取 vendor 包（对照 ros_gz_sim）：gz-sim8→gz_sim_vendor、gz-plugin2→gz_plugin_vendor、
       gz-transport13→gz_transport_vendor、gz-msgs10→gz_msgs_vendor -->
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>